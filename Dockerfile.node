# ============================================================================
# SOVEREIGN FX TRADING BOT (PRODA/NEXUS): NODE/EXPRESS BACKEND DOCKERFILE
# Stage 1: Build static assets and bundled CJS server
# ============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ============================================================================
# Stage 2: Production runtime environment
# ============================================================================

FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --only=production

COPY --from=builder /app/dist ./dist

EXPOSE 3000

ENV PORT=3000
ENV NODE_ENV=production

CMD ["node", "dist/server.cjs"]
