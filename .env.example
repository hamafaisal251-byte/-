# ============================================================================
# SOVEREIGN ALGORITHMIC TRADING BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================

# Secure Google Gemini API Key for server-side C++ kernel optimizations and analyses.
# Set this key under 'Settings' -> 'Secrets' inside AI Studio for automatic execution.
GEMINI_API_KEY=

# Secure Mutating Endpoint Key (Bearer Token required for /api/v1/control/*, /api/v1/candidates/*)
API_MUTATE_KEY=

# Configurable evolutionary candidate population size (Default: 12)
CANDIDATE_POPULATION_SIZE=12

# OANDA API Credentials for training Stable-Baselines3 on real historical forex data
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# ============================================================================
# REAL POSTGRESQL DATABASE CONFIGURATION
# ============================================================================
# Connect using a single URL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sovereign_db
# Or individual parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sovereign_db


